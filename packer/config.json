{
    "agent": {
        "metrics_collection_interval": 10,
        "logfile": "/var/logs/amazon-cloudwatch-agent.log"
    },
    "logs": {
        "logs_collected": {
            "files": {
                "collect_list": [
                    {
                        "file_path": "/opt/csye6225/logs/error.log",
                        "log_group_name": "csye6225",
                        "log_stream_name": "error"
                    },
                    {
                        "file_path": "/opt/csye6225/logs/info.log",
                        "log_group_name": "csye6225",
                        "log_stream_name": "info"
                    },
                    {
                        "file_path": "/opt/csye6225/logs/warn.log",
                        "log_group_name": "csye6225",
                        "log_stream_name": "warn"
                    }
                ]
            }
        },
        "log_stream_name": "cloudwatch_log_stream_final_review"
    },
    "metrics": {
          "namespace": "cloudwatch_log_stream_final_review",
          "metrics_collected": {
              "statsd": {
                  "service_address": ":8125",
                  "metrics_collection_interval": 10
              }
          }
      }
  }